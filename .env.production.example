# Copie este arquivo para .env no servidor e preencha os valores reais.
# Nunca envie o arquivo .env ao GitHub.

NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO
PORT=3000

# Painel administrativo
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=DEFINA_UMA_SENHA_LONGA_E_EXCLUSIVA
# Gere com: openssl rand -base64 48
ADMIN_SESSION_SECRET=COLE_AQUI_UM_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_CARACTERES

# BravoPay
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_SECRET=

# Os arquivos JSON e imagens serão gravados no volume Docker /app/data.
FORTI_STORAGE_DIR=/app/data

# Variáveis usadas pela FortiCestas.
# Em produção, configure estes valores em Vercel > Project > Settings > Environment Variables.
# O Vercel Blob já está conectado ao projeto e fornece BLOB_READ_WRITE_TOKEN automaticamente.

NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO-VERCEL

# Painel administrativo
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Gere um valor exclusivo com: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# BravoPay (credenciais privadas; nunca use prefixo NEXT_PUBLIC_)
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_SECRET=

# Apenas para desenvolvimento local/Docker; não é usado na Vercel.
FORTI_STORAGE_DIR=./data

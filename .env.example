# Armazenamento persistente em servidor Node.js (não usar Vercel para pedidos reais)
FORTI_STORAGE_DIR=./data

# Painel administrativo — configure os valores somente no servidor
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-forte
# Gere com: openssl rand -base64 48
ADMIN_SESSION_SECRET=adicione-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# BravoPay (somente servidor — nunca usar prefixo NEXT_PUBLIC_)
BRAVOPAY_API_KEY=
BRAVOPAY_WEBHOOK_SECRET=

# URL pública
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
